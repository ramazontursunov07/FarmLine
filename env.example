# Bu fayldan nusxa oling: cp .env.example .env  (Windows: copy .env.example .env)
# Haqiqiy .env faylini hech qachon GitHub'ga yuklamang va boshqalarga yubormang.

# --- Asosiy (majburiy) ---
# Yangisini yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-qator-yozing
# Kompyuterda True, hostingda False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Parol tiklash havolasi olib boradigan sayt manzili (hostingda https://sizning-domen.uz)
FRONTEND_URL=http://localhost:5173

# --- Baza ---
# Bo'sh qoldirsangiz, db.sqlite3 ishlatiladi. Hostingda PostgreSQL manzili:
# DATABASE_URL=postgres://user:parol@host:5432/baza

# --- Telegram bot ---
# BotFather bergan token va botning username'i (@ belgisisiz)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Hostingda botni veb-server ichida ishga tushirish uchun 1 qiling
# RUN_BOT=1

# --- Kunlik hisobot va tug'ish eslatmalarini avtomatik yuborish ---
# Uzun tasodifiy qator. GitHub Secrets'dagi CRON_SECRET bilan aynan bir xil bo'lishi kerak.
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(40))"
# CRON_SECRET=

# --- AI yordamchi ---
# gemini (standart) yoki openai (Groq, OpenRouter kabi OpenAI-mos API)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# openai rejimi uchun:
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=

# --- Boshqa (ixtiyoriy) ---
# Kirish sessiyasi necha kun saqlanadi (standart 60)
# JWT_REFRESH_DAYS=60
